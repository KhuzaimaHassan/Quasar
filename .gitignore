# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
backend/.env
.mypy_cache/
.ruff_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# Local tooling / Agent cache
.agents/

# Generated RAG evaluation reports. Keep the current baseline referenced by Roadmap.md.
/evals/results/eval_report_*.json
/evals/results/eval_report_*.md
!/evals/results/eval_report_20260828_155553.json
!/evals/results/eval_report_20260828_155553.md

# Unused Next.js starter assets (kept locally, not part of the app)
/public/file.svg
/public/globe.svg
/public/next.svg
/public/vercel.svg
/public/window.svg
